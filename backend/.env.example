# Jeva backend settings, loaded automatically at startup.
# Copy to backend/.env (start.sh does this for you) and add your keys.
# With no keys, Jev and the LLM run on local stand-ins, so the app still works offline.
# Variables already exported in your shell take precedence.

# ---- Jev (TypeSafe System One): semantic triage ----
TYPESAFE_API_KEY=
# auto: live if TypeSafe accepts the key, else the local stand-in (the UI says why)
# live: always call TypeSafe, show key errors on each ticket
# mock: always use the local stand-in
JEV_MODE=auto

# ---- Reply-writing LLM ----
# auto picks Claude if ANTHROPIC_API_KEY is set, then Groq, then the local mock.
LLM_PROVIDER=auto

# Groq openai/gpt-oss-20b (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low

# Claude (paid)
# ANTHROPIC_API_KEY=
